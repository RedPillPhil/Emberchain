# api-server — deploy on Railway / Fly.io / VM (always-on, NOT Vercel).
# Bridge relayer runs inside this process.

PORT=8080
NODE_ENV=production

# PostgreSQL (Neon, Supabase, Railway Postgres) — required for bridge_events
DATABASE_URL=postgresql://user:pass@host:5432/emberchain

# Canonical Emberchain node (same for reads and writes)
CHAIN_NODE_URL=https://emberchain.duckdns.org
READ_NODE_URL=https://emberchain.duckdns.org

# Bridge relayer (hot wallet — fund with Base ETH for gas)
BRIDGE_RELAYER_PRIVATE_KEY=

# Airdrop distributor — NEVER commit real key. Server: /etc/emberchain/api-server.env
AIRDROP_DISTRIBUTOR_PRIVATE_KEY=
BASE_RPC_URL=https://mainnet.base.org
EMBR_RPC_URL=https://emberchain.duckdns.org/api/rpc

EMBER_BRIDGE_ADDRESS=0x9362587019ea0e4ef90fbd981c615d4441d9d2c4
EMBERCHAIN_BRIDGE_ADDRESS=0x1573EdF8F933601e6f37AC9B104cF62C7f85a0F4

# Optional: disable relayer loops (if running relay worker separately)
# BRIDGE_RELAYER_ENABLED=false
