# Copy to .env.local for local dev.

# Emberchain node (balances, blocks, bridge locks)
VITE_CHAIN_NODE_URL=https://emberchain.duckdns.org

# Optional api-server (bridge register, token launch, DEX orders)
# When unset in prod, falls back to VITE_CHAIN_NODE_URL; in dev, same-origin /api is proxied.
VITE_API_URL=

# Dev proxy target for /api (defaults to VITE_CHAIN_NODE_URL)
# VITE_API_PROXY_TARGET=http://localhost:8080

# Token launch wizard — set to "true" only to hide the launch UI during api-server maintenance
# VITE_TOKEN_LAUNCH_DOWN=true
