# Copy to .env.local for local dev, or set in Vercel → Environment Variables.

# Required for exchange, bridge register, community, token launch (Railway/Fly/etc.)
# Chain reads (balance, blocks, mining) use VITE_CHAIN_NODE_URL when this is unset.
VITE_API_URL=

# Emberchain node (defaults to public mainnet node)
VITE_CHAIN_NODE_URL=https://emberchain.duckdns.org

# Exchange API — legacy Replit host holds escrow state until migrated to duckdns
VITE_EXCHANGE_API_URL=https://po-w-chain.replit.app

# Exchange marketplace — set to "false" when escrow is live again
# VITE_EXCHANGE_ESCROW_DOWN=false

# Bridge contracts (Base + Emberchain mainnet)
VITE_EMBER_BRIDGE_ADDRESS=0x9362587019ea0e4ef90fbd981c615d4441d9d2c4
VITE_EMBERCHAIN_BRIDGE_ADDRESS=0x1573EdF8F933601e6f37AC9B104cF62C7f85a0F4
VITE_EMBERSWAP_ADDRESS=0x4e8821099cC706d9C4e6E7C05923C2950E361459
VITE_WEMBR_ADDRESS=0x9362587019Ea0e4ef90fbd981c615d4441D9D2c4

# Operator email alerts (chain-node on duckdns — not the wallet UI)
# ADMIN_ALERT_EMAIL=you@example.com
# RESEND_API_KEY=re_...
# RESEND_FROM=Emberchain Alerts <alerts@yourdomain.com>

# Local dev: proxy /api to api-server (optional)
# VITE_API_PROXY_TARGET=http://localhost:8080
