{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && pnpm install",
  "buildCommand": "cd ../.. && pnpm --filter @workspace/wallet run build && BASE_PATH=/ember-delta/ pnpm --filter @workspace/ember-delta run build && node scripts/stage-ember-delta.mjs",
  "outputDirectory": "dist/public",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://emberchain.duckdns.org/api/:path*" },
    { "source": "/ember-delta", "destination": "/ember-delta/index.html" },
    { "source": "/ember-delta/:path*", "destination": "/ember-delta/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
