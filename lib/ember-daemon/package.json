{
  "name": "@workspace/ember-daemon",
  "version": "1.0.0",
  "description": "Standalone Emberchain blockchain daemon — runs without any hosted infrastructure",
  "private": true,
  "type": "module",
  "bin": {
    "emberd": "./dist/cli.mjs"
  },
  "exports": {
    ".": "./dist/embedded.mjs"
  },
  "scripts": {
    "build": "node ./build.mjs",
    "dev": "node --enable-source-maps ./dist/cli.mjs",
    "start": "node --enable-source-maps ./dist/cli.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ethereumjs/tx": "^10.1.2",
    "@ethereumjs/util": "10.1.2",
    "@workspace/api-zod": "workspace:*",
    "@workspace/chain-core": "workspace:*",
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.6",
    "ethers": "^6.17.0",
    "express": "^5.2.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
