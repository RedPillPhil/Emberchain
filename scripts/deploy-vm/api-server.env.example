# Copy to /etc/emberchain/api-server.env and fill in secrets.
# Then: systemctl enable --now emberchain-api

PORT=8081
NODE_ENV=production

DATABASE_URL=postgresql://emberchain:YOUR_PASSWORD@127.0.0.1:5432/emberchain

CHAIN_NODE_URL=http://127.0.0.1:8080
READ_NODE_URL=http://127.0.0.1:8080
MINING_NODE_URL=http://127.0.0.1:8080

# Must match chain-node internal auth (optional for exchange; required for internal calls)
SESSION_SECRET=emberchain-secret-2026
CHAIN_NODE_INTERNAL_SECRET=emberchain-secret-2026

# Bridge relayer — fund with Base ETH for gas (also runs on chain-node if only bridging needed)
BRIDGE_RELAYER_PRIVATE_KEY=
BASE_RPC_URL=https://mainnet.base.org
EMBR_RPC_URL=http://127.0.0.1:8080/api/rpc

EMBER_BRIDGE_ADDRESS=0x9362587019ea0e4ef90fbd981c615d4441d9d2c4
EMBERCHAIN_BRIDGE_ADDRESS=0x1573EdF8F933601e6f37AC9B104cF62C7f85a0F4
UNIVERSAL_BRIDGE_ADDRESS=0x6F86927ee98757eB478cc5be8696Ee9927eDa3E2
TOKEN_LAUNCH_FEE_ADDRESS=0x2Cf79aaf301a6c41F03eB7C2667564949F44c0ce

# PoW / UTXO launch wallet derivation
BRIDGE_UTXO_PRIVATE_KEY=

# Exchange payment verification (at least one recommended)
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=
POLYGONSCAN_API_KEY=

# Optional
# TRANSAK_API_KEY=
# BRIDGE_RELAYER_ENABLED=true
