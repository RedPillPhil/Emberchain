# Copy to /etc/emberchain/api-server.env and fill in secrets.
# Then: systemctl enable --now emberchain-api

PORT=8081
NODE_ENV=production

DATABASE_URL=postgresql://emberchain:YOUR_PASSWORD@127.0.0.1:5432/emberchain

CHAIN_NODE_URL=http://127.0.0.1:8080
READ_NODE_URL=http://127.0.0.1:8080
MINING_NODE_URL=http://127.0.0.1:8080

# Must match chain-node internal auth (optional for exchange; required for internal calls)
SESSION_SECRET=emberchain-secret-2026
CHAIN_NODE_INTERNAL_SECRET=emberchain-secret-2026

# Bridge relayer — fund with Base ETH for gas + token launches.
# Must be UniversalBridge owner (registerToken) and relayer (bridgeIn).
# BRIDGE_RELAYER_ENABLED=false only disables the EMBR lock relayer loop — token launch still uses this key.
BRIDGE_RELAYER_PRIVATE_KEY=
BRIDGE_RELAYER_ENABLED=false
BASE_RPC_URL=https://mainnet.base.org
EMBR_RPC_URL=http://127.0.0.1:8080/api/rpc

EMBER_BRIDGE_ADDRESS=0x9362587019ea0e4ef90fbd981c615d4441d9d2c4
EMBERCHAIN_BRIDGE_ADDRESS=0x1573EdF8F933601e6f37AC9B104cF62C7f85a0F4
UNIVERSAL_BRIDGE_ADDRESS=0x6F86927ee98757eB478cc5be8696Ee9927eDa3E2
# Optional legacy override — listing fees MUST land in the BRIDGE_RELAYER wallet (same key above).
# TOKEN_LAUNCH_FEE_ADDRESS=

# Required for per-launch escrow addresses (32-byte hex, no 0x prefix)
BRIDGE_UTXO_PRIVATE_KEY=

# Exchange payment verification.
# EVM payments are read over JSON-RPC, so no explorer API keys are needed.
# Etherscan retired the per-chain V1 APIs (bscscan/polygonscan/basescan/arbiscan)
# on 2025-08-15, and its V2 API puts Base behind a paid plan.
# Each var is optional — omit it to use the public default shown.
# Comma-separate multiple URLs to add fallbacks.
# ETH_RPC_URL=https://ethereum-rpc.publicnode.com,https://eth.drpc.org
# ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
# BSC_RPC_URL=https://bsc-dataseed.binance.org
# POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
# BASE_RPC_URL is already set above and is reused for exchange payments.

# Confirmations required before EMBR is released (optional overrides)
# ETH_CONFIRMATIONS=12
# BASE_CONFIRMATIONS=30
# ARBITRUM_CONFIRMATIONS=120
# BSC_CONFIRMATIONS=15
# POLYGON_CONFIRMATIONS=128

# Optional
# TRANSAK_API_KEY=

# Chain Invaders — ECDSA game-server signing key (NOT a Chainlink oracle).
# The api-server signs (player, dayId, score, playHash); the contract verifies with ECDSA.
# Deploy ChainInvaders with GAME_SIGNER = the address of this key.
# CHAIN_INVADERS_SIGNER_KEY=0x...
# (aliases: GAME_SIGNER_PRIVATE_KEY, CHAIN_INVADERS_ORACLE_KEY)
#
# After deploy, set the contract address so the UI + auto-settler can talk to it:
# CHAIN_INVADERS_ADDRESS=0x...
# Optional separate settler key (defaults to signer key). Needs a little EMBR for gas.
# CHAIN_INVADERS_SETTLER_KEY=0x...
# Auto-settler pays 75% cumulative + 25% best-single winners after 8pm Eastern — no claim.