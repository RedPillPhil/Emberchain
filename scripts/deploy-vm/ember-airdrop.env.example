# Copy to /etc/emberchain/ember-airdrop.env
# Deploy: bash scripts/deploy-vm/deploy-ember-airdrop.sh
#
# Frontend-only env — NO private keys here.
# EMBR payouts use AIRDROP_DISTRIBUTOR_PRIVATE_KEY in /etc/emberchain/api-server.env

PORT=43774
HOSTNAME=0.0.0.0
NEXT_PUBLIC_BASE_PATH=/airdrop
NEXT_PUBLIC_SITE_ORIGIN=https://emberchain.org
NEXT_PUBLIC_EMBER_RPC=https://emberchain.org/api/rpc
