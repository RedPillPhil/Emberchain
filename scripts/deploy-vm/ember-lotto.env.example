# Copy to /etc/emberchain/ember-lotto.env
# Deploy: bash scripts/deploy-vm/deploy-ember-lotto.sh

HOSTNAME=0.0.0.0
PORT=43773

NEXT_PUBLIC_BASE_PATH=/lotto
NEXT_PUBLIC_SITE_ORIGIN=https://emberchain.org

# Live lottery contracts (see github.com/RedPillPhil/ember-lotto deployments.json)
NEXT_PUBLIC_EMBER_LOTTERY=0x6e0dc9421292a72d9bbb8ccb41e33448b96ff28e
NEXT_PUBLIC_BASE_LOTTERY=0x53be2a4c134ed203cd0b683d8e66bef4a0f490b6
LOTTERY_CONTRACT_ADDRESS=0x6e0dc9421292a72d9bbb8ccb41e33448b96ff28e
LOTTERY_CONTRACT_BASE=0x53be2a4c134ed203cd0b683d8e66bef4a0f490b6

# Draw operator — only address allowed to requestDraw() / fulfillDraw()
# Usually the same key as BRIDGE_RELAYER_PRIVATE_KEY on the seed server.
DRAW_OPERATOR_PRIVATE_KEY=
DRAW_OPERATOR_ADDRESS=0x9954146017aCE1994BC076243Ed49EC28C64D77B

# Optional: protect POST /lotto/api/draw/run
# DRAW_SECRET=
